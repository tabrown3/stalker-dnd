{
  "name": "stalker-dnd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Companion app for a STALKER tabletop adaptation: data pipeline and rules engine.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "data": "node --disable-warning=ExperimentalWarning scripts/build-data.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "expo": "~58.1.0",
    "expo-clipboard": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "react-native": "^0.88.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "main": "index.ts"
}
